rules_version = '2';

// ─── FamilyQuest Firestore Security Rules ────────────────────────────────────
// Each user can only read/write their own data. No cross-user access anywhere.
service cloud.firestore {
  match /databases/{database}/documents {

    // /users/{uid}/trips/{tripId} — saved itineraries, private to the owner
    match /users/{userId}/trips/{tripId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // /users/{uid} — profile doc (future use: preferences, settings)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // /rateLimits/{uid} — server-side generation counters (Cloud Function only)
    match /rateLimits/{userId} {
      allow read, write: if false; // never accessed from the client
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
